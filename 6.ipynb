   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "regions = ['North','South','East','West']\n",
    "revenue = [3000,2000,1500,1000]\n",
    "\n",
    "plt.pie(revenue,labels=regions,colors=['skyblue','yellow','green','blue'],autopct='%1.1f%%')\n",
    "\n",
    "plt.title('Revenue by Region chart')\n",
    "\n",
    "plt.show()\n"
   ]
  }
 ],
